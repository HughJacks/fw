#!/bin/zsh
# fw — open fw's editor in the browser, starting its local server if needed.
#
#   fw            open the editor (also: fw open, fw o)
#   fw list       list every pericope (also: fw ls)
#   fw stop       stop the local server
#   fw --NAME …   any of these on the store in NAME/ beside fw (e.g. fw --docs)
#
# $FW_DATA picks another store; $FW_WEB_PORT another port.

root="${0:A:h:h}"
py="${FW_PYTHON:-$root/.venv/bin/python}"
[[ -x "$py" ]] || py=python3
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
port=8020

if [[ "$1" == --?* && "$1" != --help ]]; then
  name="${1#--}"; shift
  export FW_DATA="$root/$name/freewrites.json"; mkdir -p "$root/$name"
  case "$name" in docs) port=8023;; portfolio) port=8024;; *) port=$(( 8030 + $(print -rn -- "$name" | cksum | cut -d' ' -f1) % 50 ));; esac
fi
port="${FW_WEB_PORT:-$port}"
url="http://127.0.0.1:$port/"
core="(fw_web\\.py|fw/web\\.py|-m fw\\.web) --port $port( |\$)"   # this core, or one started by an older fw
up() { curl -s -o /dev/null -m 1 "${url}api/stamp"; }

case "${1:-open}" in
  open|o|web)
    running="$(curl -s -m 1 "${url}api/version" 2>/dev/null)"
    if [[ -n "$running" ]] && ! print -r -- "$running" | grep -q "\"code\": \"$("$py" -m fw.web --code-stamp)\""; then
      pkill -f "$core"; for _ in {1..50}; do up || break; sleep 0.1; done
    fi
    if ! up; then
      "$py" -c 'import os, sys; os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' "$py" -m fw.web --port "$port" --no-open \
        </dev/null >"$root/.fw-web-$port.log" 2>&1 &!
      for _ in {1..50}; do up && break; sleep 0.1; done
    fi
    open "$url" 2>/dev/null || xdg-open "$url" 2>/dev/null
    print -- "fw: $url" ;;
  list|ls) exec "$py" -m fw.store list ;;
  stop) pkill -f "$core" && print -- "fw: stopped" ;;
  migrate|merge) exec "$py" -m fw.store "$@" ;;
  *) sed -n '2,9p' "$0" | cut -c3-; [[ "$1" == (help|-h|--help) ]] ;;
esac
